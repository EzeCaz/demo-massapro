generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  name                String?
  passwordHash        String?
  role                String           @default("user") // "super_admin", "admin", "user", "demo"
  company             String?           // legacy free-text field, kept for backward compat
  companyId           String?          // FK to Company (new hierarchy)
  companyRef          Company?          @relation("CompanyMembers", fields: [companyId], references: [id])
  teamId              String?          // FK to Team (new hierarchy)
  teamRef             Team?            @relation("TeamMembers", fields: [teamId], references: [id])
  jobTitle            String?
  phone               String?
  linkedinUrl         String?
  country             String?
  city                String?
  avatarUrl           String?
  bio                 String?
  status              String           @default("active") // "active", "pending", "suspended", "deleted"
  approvedBy          String?          // user id of the super_admin who approved
  approvedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  scenarios           Scenario[]
  integrationSetups   IntegrationSetup[]
  collaborations      Collaboration[]
  comments            ScenarioComment[]
  changeLogs          ChangeLog[]
  adminNotesSent      AdminNote[]      @relation("SentNotes")
  adminNotesReceived  AdminNote[]      @relation("ReceivedNotes")
  invitesSent         Invite[]         @relation("SentInvites")
  invitesReceived     Invite[]         @relation("ReceivedInvites")
  supportTickets      SupportTicket[]  @relation("SubmittedTickets")
  assignedTickets     SupportTicket[]  @relation("AssignedTickets")
  ticketComments      TicketComment[]
  sowSnapshots        SOWSnapshot[]    @relation("OwnedSOWSnapshots")
  ownedDemos          Demo[]           @relation("OwnedDemos")
  demoAccesses        DemoAccess[]     @relation("DemoAccesses")
}

// Self-relation note: User.approvedBy stores the id of the super_admin who
// approved this user. We do NOT model it as a Prisma relation (would need
// @unique on approvedBy, which we don't want — many users can share the
// same approver). Read it as a plain string FK and join manually in API code.

model Scenario {
  id                        String            @id @default(cuid())
  clientId                  String
  client                    User              @relation(fields: [clientId], references: [id])
  demoId                    String?           // FK to Demo (new hierarchy). Nullable for backward compat — migration back-fills existing scenarios into a "Default Demo" container.
  demo                      Demo?             @relation(fields: [demoId], references: [id], onDelete: SetNull)
  name                      String
  order                     Int               @default(0)
  status                    String            @default("draft") // "draft" or "submitted"
  company                   String? // Per-scenario company override
  companyWebsiteUrl         String?
  overview                  String?
  overviewEs                String?
  overviewEn                String?
  overviewHe                String?
  companyGoals              String?
  companyGoalsEs            String?
  companyGoalsEn            String?
  companyGoalsHe            String?
  aiAutomationsRequired     String?
  aiAutomationsRequiredEs   String?
  aiAutomationsRequiredEn   String?
  aiAutomationsRequiredHe   String?
  demoFocusAreas            String?
  demoFocusAreasEs          String?
  demoFocusAreasEn          String?
  demoFocusAreasHe          String?
  languagesVoice            String?
  languagesText             String?
  scriptsFlows              String?
  scriptsFlowsEs            String?
  scriptsFlowsEn            String?
  scriptsFlowsHe            String?
  knowledgeBaseText         String?
  knowledgeBaseTextEs       String?
  knowledgeBaseTextEn       String?
  knowledgeBaseTextHe       String?
  faqObjectionHandling      String?
  faqObjectionHandlingEs    String?
  faqObjectionHandlingEn    String?
  faqObjectionHandlingHe    String?
  requiredIntegrations      String?
  requiredIntegrationsEs    String?
  requiredIntegrationsEn    String?
  requiredIntegrationsHe    String?
  erpCrmCcaas               String?
  erpCrmCcaasEs             String?
  erpCrmCcaasEn             String?
  erpCrmCcaasHe             String?
  submittedDate             DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime         @updatedAt
  kpis                      KPI[]
  attachments               Attachment[]
  links                    ScenarioLink[]
  collaborations            Collaboration[]
  changeLogs                ChangeLog[]
  comments                  ScenarioComment[]
  adminNotes                AdminNote[]
}

model KPI {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  name        String
  targetValue String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Integration Setup form — mirrors the demo scenario's multi-language pattern:
// each text field has a base variant + English/Spanish/Hebrew variants.
// The base variant is edited in the main form; En/Es/He are populated via
// the translation endpoint and used by the (future) PDF export via ?lang=.
model IntegrationSetup {
  id                                    String    @id @default(cuid())
  clientId                              String
  client                                User      @relation(fields: [clientId], references: [id])
  name                                  String
  status                                String    @default("draft") // "draft" or "submitted"
  submittedDate                         DateTime?
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime  @updatedAt

  // 28 fields, each with base + En + Es + He variants.
  // Field names use camelCase, suffixes are En/Es/He.
  languagesToUse                        String?
  languagesToUseEn                      String?
  languagesToUseEs                      String?
  languagesToUseHe                      String?

  telNumbers                            String?
  telNumbersEn                          String?
  telNumbersEs                          String?
  telNumbersHe                          String?

  queueSkills                           String?
  queueSkillsEn                         String?
  queueSkillsEs                         String?
  queueSkillsHe                         String?

  portedOrWhitelisted                   String?
  portedOrWhitelistedEn                 String?
  portedOrWhitelistedEs                 String?
  portedOrWhitelistedHe                 String?

  campaignStructure                     String?
  campaignStructureEn                   String?
  campaignStructureEs                   String?
  campaignStructureHe                   String?

  crmDbAccess                           String?
  crmDbAccessEn                         String?
  crmDbAccessEs                         String?
  crmDbAccessHe                         String?

  integrationsNeeded                    String?
  integrationsNeededEn                  String?
  integrationsNeededEs                  String?
  integrationsNeededHe                  String?

  waitingPriority                       String?
  waitingPriorityEn                     String?
  waitingPriorityEs                     String?
  waitingPriorityHe                     String?

  autoDialer                            String?
  autoDialerEn                          String?
  autoDialerEs                          String?
  autoDialerHe                          String?

  omniSetup                             String?
  omniSetupEn                           String?
  omniSetupEs                           String?
  omniSetupHe                           String?

  reportsRequired                       String?
  reportsRequiredEn                     String?
  reportsRequiredEs                     String?
  reportsRequiredHe                     String?

  customerDataStorage                   String?
  customerDataStorageEn                 String?
  customerDataStorageEs                 String?
  customerDataStorageHe                 String?

  initialDataImport                     String?
  initialDataImportEn                   String?
  initialDataImportEs                   String?
  initialDataImportHe                   String?

  voiceUsersCount                       String?
  voiceUsersCountEn                     String?
  voiceUsersCountEs                     String?
  voiceUsersCountHe                     String?

  phoneNumberRequirements               String?
  phoneNumberRequirementsEn             String?
  phoneNumberRequirementsEs             String?
  phoneNumberRequirementsHe             String?

  sipTrunkSetup                         String?
  sipTrunkSetupEn                       String?
  sipTrunkSetupEs                       String?
  sipTrunkSetupHe                       String?

  sipTrunkConfig                        String?
  sipTrunkConfigEn                      String?
  sipTrunkConfigEs                      String?
  sipTrunkConfigHe                      String?

  diallerCampaign                       String?
  diallerCampaignEn                     String?
  diallerCampaignEs                     String?
  diallerCampaignHe                     String?

  leadsPerDay                           String?
  leadsPerDayEn                         String?
  leadsPerDayEs                         String?
  leadsPerDayHe                         String?

  inboundVoiceQueue                     String?
  inboundVoiceQueueEn                   String?
  inboundVoiceQueueEs                   String?
  inboundVoiceQueueHe                   String?

  inboundCallsPerDay                    String?
  inboundCallsPerDayEn                  String?
  inboundCallsPerDayEs                  String?
  inboundCallsPerDayHe                  String?

  ivrFlow                               String?
  ivrFlowEn                             String?
  ivrFlowEs                             String?
  ivrFlowHe                             String?

  outOfHoursRouting                     String?
  outOfHoursRoutingEn                   String?
  outOfHoursRoutingEs                   String?
  outOfHoursRoutingHe                   String?

  emailRequirements                     String?
  emailRequirementsEn                   String?
  emailRequirementsEs                   String?
  emailRequirementsHe                   String?

  whatsappRequirements                  String?
  whatsappRequirementsEn                String?
  whatsappRequirementsEs                String?
  whatsappRequirementsHe                String?

  smsRequirements                        String?
  smsRequirementsEn                     String?
  smsRequirementsEs                     String?
  smsRequirementsHe                     String?

  facebookInstagramRequirements         String?
  facebookInstagramRequirementsEn       String?
  facebookInstagramRequirementsEs       String?
  facebookInstagramRequirementsHe       String?

  ticketingRequirements                 String?
  ticketingRequirementsEn               String?
  ticketingRequirementsEs               String?
  ticketingRequirementsHe               String?

  // Magic-link shares for this setup. Each row grants a specific email
  // access to view/edit this single setup without a password — the magic
  // link contains the token and signs them in via NextAuth's signIn
  // callback (which looks up the share by token).
  shares                                IntegrationSetupShare[]
}

// Magic-link share of a single Integration Setup with a single external
// user identified by email. The recipient doesn't need a password or a
// prior account — visiting /s/[token] signs them in with a JWT that
// scopes them to only the setups/scenarios their email has shares for.
model IntegrationSetupShare {
  id          String   @id @default(cuid())
  setupId     String
  setup       IntegrationSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  email       String   // recipient email (lowercased on write by the API)
  token       String   @unique // uuid v4 — the magic-link secret
  accessLevel String   @default("view") // "view" or "edit"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([setupId, email]) // one active share per (setup, email) pair
}

model Attachment {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String
  fileType    String?
  fileSize    Int?
  category    String? // "knowledge_base" or "attachment"
  data        Bytes? // file content stored in DB — required on serverless (Vercel) where the disk is ephemeral; also enables audio/image inline playback
  createdAt   DateTime @default(now())
}

model ScenarioLink {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  url         String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Collaboration {
  id             String   @id @default(cuid())
  scenarioId     String
  scenario       Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  collaboratorId String
  collaborator   User     @relation(fields: [collaboratorId], references: [id])
  accessLevel    String   @default("view") // "view" or "edit"
  publicToken    String?  @unique
  createdAt      DateTime @default(now())
}

model ChangeLog {
  id            String   @id @default(cuid())
  scenarioId    String
  scenario      Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  fieldName     String
  oldValue      String?
  newValue      String?
  changeSummary String?
  createdAt     DateTime @default(now())
}

model ScenarioComment {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  content     String
  taggedUsers String? // comma-separated emails
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminNote {
  id            String   @id @default(cuid())
  scenarioId    String
  scenario      Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  sentByAdminId String
  sentByAdmin   User     @relation("SentNotes", fields: [sentByAdminId], references: [id])
  clientId      String
  client        User     @relation("ReceivedNotes", fields: [clientId], references: [id])
  note          String
  isRead        Boolean  @default(false)
  sendEmail     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Invite {
  id            String    @id @default(cuid())
  token         String    @unique
  email         String
  name          String?
  company       String?
  password      String? // temporary password
  sentByAdminId String
  sentByAdmin   User     @relation("SentInvites", fields: [sentByAdminId], references: [id])
  usedByUserId  String?
  usedByUser    User?     @relation("ReceivedInvites", fields: [usedByUserId], references: [id])
  usedAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// NEW MODELS — Task 21 (Demo Platform, Hierarchical User Management, Support)
// ---------------------------------------------------------------------------

// A Demo is the top-level container in the demo-platform hierarchy.
// Each Demo has an owner (the user who created it) and can have multiple
// Scenarios. Other users can be granted access to a Demo via DemoAccess
// rows (view / comment / edit). A Demo is required to create a Scenario.
//
// Migration back-fills any existing Scenarios that don't have a demoId
// into a per-owner "Default Demo" container.
//
// Visibility rule (per the user's brief):
//   - super_admin: sees ALL Demos and Scenarios
//   - admin: sees ALL Demos and Scenarios (same as super_admin for read)
//   - regular user: sees ONLY Demos where they're the owner OR have a
//     DemoAccess row with accessLevel 'view' / 'comment' / 'edit'.
//     Any Scenario whose Demo they can't see is hidden from ALL tabs
//     (Demo list, Scenarios list, Export).
model Demo {
  id          String     @id @default(cuid())
  name        String
  description String?
  ownerId     String     // user who created the Demo
  owner       User       @relation("OwnedDemos", fields: [ownerId], references: [id])
  status      String     @default("active") // "active" or "archived"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  scenarios   Scenario[]
  access      DemoAccess[]
}

// DemoAccess grants a specific user access to a specific Demo.
// accessLevel: 'view' (read-only), 'comment' (read + comment), 'edit' (full).
// One row per (demoId, userId) pair.
model DemoAccess {
  id          String   @id @default(cuid())
  demoId      String
  demo        Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("DemoAccesses", fields: [userId], references: [id], onDelete: Cascade)
  accessLevel String   @default("view") // "view" | "comment" | "edit"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([demoId, userId])
}

// A Company is a top-level unit in the user hierarchy. Users belong to a
// Company. Each Company has multiple Teams. Only super_admin can create,
// edit or delete Companies.
model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  status      String   @default("active") // "active" or "archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     User[]   @relation("CompanyMembers")
  teams       Team[]
}

// A Team is a sub-unit within a Company. Users belong to one Team (within
// their Company). Only super_admin can create, edit or delete Teams.
model Team {
  id          String   @id @default(cuid())
  name        String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description String?
  status      String   @default("active") // "active" or "archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     User[]   @relation("TeamMembers")

  @@unique([companyId, name])
}

// Support ticket submitted by a user (any role) to MassaPro support.
// Tickets are visible to: the submitter, assigned agent (admin/super_admin),
// and super_admin. Tickets can have CC emails (additional recipients),
// attachments, and a comment thread.
model SupportTicket {
  id            String   @id @default(cuid())
  title         String
  subject       String
  description   String
  priority      String   @default("normal") // "low", "normal", "high", "critical"
  status        String   @default("open")   // "open", "in_progress", "resolved", "closed"
  category      String?  // free-text — populated by MassaPro support later
  submittedById String
  submittedBy   User     @relation("SubmittedTickets", fields: [submittedById], references: [id])
  assignedToId  String?
  assignedTo   User?     @relation("AssignedTickets", fields: [assignedToId], references: [id])
  ccEmails      Json?    // array of strings — CC email addresses
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attachments   SupportTicketAttachment[]
  comments      TicketComment[]
}

// Attachment on a support ticket — file content stored in DB (serverless).
model SupportTicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String?
  fileSize     Int?
  data         Bytes?
  createdAt    DateTime @default(now())
}

// Comment on a support ticket — used by MassaPro support staff to reply
// to the submitter, and by the submitter to add follow-up info.
model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String
  isInternal Boolean  @default(false) // staff-only internal note (not shown to submitter)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Persisted SOW documents — one per Company/project. The SOW Builder UI
// at /sow generates a SOWSnapshot when the user clicks "Save to Platform".
// (Auto-saved local-state drafts continue to live in localStorage; this
// table is for the canonical saved version that the user wants to keep
// on the platform and that admins can edit via the Global Admin tab.)
model SOWSnapshot {
  id              String   @id @default(cuid())
  name            String
  ownerId         String
  owner           User     @relation("OwnedSOWSnapshots", fields: [ownerId], references: [id])
  companyId       String?
  teamId          String?
  status          String   @default("draft") // "draft", "submitted", "approved", "rejected"
  payload         Json     // full SOW state (cover, services, tasks, specs, milestones)
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
