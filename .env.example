# MassaPro Environment Variables
# Copy this file to .env and fill in the values

# Database — PostgreSQL connection string
# Option 1: Neon (recommended for Vercel) — https://neon.tech
# Option 2: Vercel Postgres — https://vercel.com/storage/postgres
# Option 3: Supabase — https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/massapro?sslmode=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Optional: NextAuth URL (auto-detected on Vercel, needed for local dev)
# NEXTAUTH_URL="http://localhost:3000"

# Seed script defaults (used by: npm run db:seed)
# SUPER_ADMIN_EMAIL="eze@massapro.com"
# SUPER_ADMIN_PASSWORD="your-secure-password"
