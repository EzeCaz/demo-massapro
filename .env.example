# MassaPro Environment Variables
# Copy this file to .env and fill in the values

# Database — PostgreSQL connection string
# For Neon:      postgresql://user:password@ep-xxx.region.aws.neon.tech/massapro?sslmode=require
# For Supabase:  postgresql://postgres:password@db.project.supabase.co:5432/postgres
# For Vercel:    Set via Vercel dashboard (no need for this file)
DATABASE_URL="postgresql://user:password@host:5432/massapro"

# Direct URL for migrations (only needed for Neon with connection pooling)
# Same as DATABASE_URL but pointing to the direct (non-pooled) connection
DIRECT_URL="postgresql://user:password@host:5432/massapro"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# NextAuth URL — the public URL of your deployment
# For production: https://your-domain.com
# For local dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Seed script defaults (used by: npm run db:seed)
SUPER_ADMIN_EMAIL="eze@massapro.com"
SUPER_ADMIN_PASSWORD="MassaPro2024!"
