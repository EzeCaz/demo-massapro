# MassaPro Environment Variables
# Copy this file to .env and fill in the values

# Database — SQLite connection string (relative to project root at runtime)
DATABASE_URL="file:dev.db"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="massapro-production-secret-2024-secure-key"

# NextAuth URL — the public URL of your deployment
# For production: set this to your actual domain
# For local dev: http://localhost:3000
# With trustHost: true, NextAuth auto-detects the host from proxy headers
NEXTAUTH_URL="http://localhost:3000"

# Seed script defaults (used by: npm run db:seed)
SUPER_ADMIN_EMAIL="eze@massapro.com"
SUPER_ADMIN_PASSWORD="MassaPro2024!"
