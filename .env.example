# MassaPro Environment Variables
# Copy this file to .env and fill in the values

# Database — SQLite connection string (relative to prisma/schema.prisma)
DATABASE_URL="file:./massapro.db"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="massapro-production-secret-2024-secure-key"

# NextAuth URL — the public URL of your deployment
NEXTAUTH_URL="https://massaprodemo.space-z.ai"

# Seed script defaults (used by: npm run db:seed)
SUPER_ADMIN_EMAIL="eze@massapro.com"
SUPER_ADMIN_PASSWORD="MassaPro2024!"
